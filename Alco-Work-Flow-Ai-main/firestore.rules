rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string
        && data.plan in ['free', 'pro', 'enterprise'];
    }

    function isValidProject(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 200
        && data.currentStep is number;
    }

    function isValidAppConfig(data) {
      return data.developerPassword is string 
        && data.rebrandingPassword is string;
    }

    // --- Collections ---

    match /settings/config {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && isEmailVerified();
      allow update: if isOwner(userId) && isValidUser(incoming()) && isEmailVerified()
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'plan']);
    }

    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isEmailVerified() && isValidProject(incoming()) && isValidId(projectId);
      allow update: if isSignedIn() && isEmailVerified() && resource.data.userId == request.auth.uid && isValidProject(incoming());
      allow delete: if isSignedIn() && isEmailVerified() && resource.data.userId == request.auth.uid;
    }

    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
