# Do not set a shared GEMINI_API_KEY for user AI calls.
# Each user must connect their own Google AI Studio Gemini API key during onboarding.
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_VALIDATION_MODEL="gemini-2.5-flash"
DEVELOPER_PASSWORD="CHANGE_ME_DEVELOPER_PASSWORD"
REBRANDING_PASSWORD="CHANGE_ME_REBRANDING_PASSWORD"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
