rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string
        && data.plan in ['free', 'pro', 'enterprise'];
    }

    function isValidNiche(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 200;
    }

    function isValidProduct(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 200
        && data.price is number;
    }

    function isValidOffer(data) {
      return data.productId is string;
    }

    function isValidAngle(data) {
      return data.productId is string;
    }

    function isValidCopy(data) {
      return data.productId is string && data.type in ['landing_page', 'email', 'ads', 'whatsapp'];
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'plan']);
    }

    match /niches/{nicheId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNiche(incoming()) && isValidId(nicheId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidProduct(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /offers/{offerId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid;
        allow write: if isSignedIn() && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid && isValidOffer(incoming());
      }
      
      match /angles/{angleId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid;
        allow write: if isSignedIn() && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid && isValidAngle(incoming());
      }

      match /copies/{copyId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid;
        allow write: if isSignedIn() && get(/databases/$(database)/documents/products/$(productId)).data.userId == request.auth.uid && isValidCopy(incoming());
      }
    }
  }
}
